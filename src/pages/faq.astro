---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { faqs } from '@/data/site';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title="FAQ"
  description="Answers to common questions about Outlook on the Desktop: Windows and Outlook compatibility, the new Outlook, shared calendars, Show Desktop, and crashes."
  structuredData={structuredData}
>
  <section class="page-header">
    <p class="eyebrow">Support</p>
    <h1>Frequently Asked Questions</h1>
    <p class="lead">Common compatibility and usage notes for Outlook on the Desktop.</p>
  </section>

  <section class="section faq-list">
    {faqs.map((faq) => (
      <details class="faq-item">
        <summary>
          <h2>{faq.question}</h2>
        </summary>
        {faq.answerHtml ? <p set:html={faq.answerHtml} /> : <p>{faq.answer}</p>}
      </details>
    ))}
  </section>
</BaseLayout>
