---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';

const releaseDate = new Date(site.releaseDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout
  title="Download"
  description={`Download Outlook on the Desktop ${site.latestVersion}, a free Windows 10 and 11 utility that pins your Outlook Classic calendar, inbox, tasks, and notes to the desktop.`}
>
  <section class="page-header">
    <p class="eyebrow">Latest release</p>
    <h1>Download Outlook on the Desktop</h1>
    <p class="lead">
      Version {site.latestVersion} was released on{' '}
      <time datetime={site.releaseDate}>{releaseDate}</time> and is available from GitHub releases.
    </p>
  </section>

  <section class="section split">
    <div class="callout">
      <h2>Current version</h2>
      <p>
        Download OotD {site.latestVersion}. The installer is code signed through SignPath
        Foundation, but Windows SmartScreen may still warn about a new release until it builds up
        download reputation.
      </p>
      <div class="actions">
        <a class="button" href={site.downloadUrl}>
          Download installer
        </a>
        <a class="button secondary" href="/release-notes">
          What's new
        </a>
        <a class="button secondary" href={site.releasesUrl} target="_blank" rel="noopener">
          All releases
        </a>
      </div>
    </div>
    <div class="callout">
      <h2>Requirements</h2>
      <ul class="compat-list">
        <li>Microsoft Outlook Classic (2010 or higher)</li>
        <li>Windows 10 or 11 (Windows 7 and XP support is available in older releases)</li>
        <li>
          Microsoft .NET 11 Desktop Runtime (the installer downloads and installs it if needed)
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
